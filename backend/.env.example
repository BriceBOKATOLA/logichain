# ---------------------------------------------------------------------------
# Modèle de configuration LOCALE de l'API LogiChain.
#
#   cp .env.example .env
#
# Les valeurs ci-dessous conviennent telles quelles pour le développement.
# En production, ce fichier est généré par Ansible à partir du Vault chiffré
# (infra/ansible/roles/app_runtime/templates/env.j2) : il n'est JAMAIS copié
# à la main sur le serveur.
#
# Toutes ces variables sont validées au démarrage par src/config/env.js.
# Une valeur manquante ou incohérente empêche le démarrage — c'est voulu.
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development
PORT=4000

# `replicaSet=rs0` est REQUIS : les transactions ACID multi-documents utilisées
# par RouteService.validateStop() n'existent pas sur un mongod autonome.
# Le replica set local est fourni par `docker compose up -d`.
MONGO_URI=mongodb://127.0.0.1:27017/logichain?replicaSet=rs0

# Secrets de signature des jetons JWT (16 caractères minimum).
# En production, ces valeurs de démonstration sont REFUSÉES au démarrage :
# générez-en de vraies avec `openssl rand -hex 32`, et deux valeurs distinctes.
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Origines autorisées, séparées par des virgules.
# « * » est toléré en local mais REFUSÉ en production.
CORS_ORIGIN=*

# Nombre de proxies de confiance devant l'API.
#   0 -> accès direct (développement local)
#   1 -> derrière Nginx (production)
# Sans cette valeur, en production, express-rate-limit verrait l'IP du reverse
# proxy pour toutes les requêtes : la limite deviendrait globale au lieu d'être
# appliquée par client.
TRUST_PROXY=0

# Limitation de débit applicative (par IP et par fenêtre).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# error | warn | info | debug — par défaut : debug hors production, info en production.
LOG_LEVEL=debug
