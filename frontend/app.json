{
  "expo": {
    "name": "LogiChainMobile",
    "slug": "logichain-mobile",
    "version": "1.0.0",
    "platforms": ["ios", "android", "web"],
    "sdkVersion": "54.0.0",
    "entryPoint": "./App.js",
    "orientation": "portrait",
    "android": {
      "package": "com.logichainplatform",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "name": "LogiChain",
      "shortName": "LogiChain",
      "backgroundColor": "#0F1712",
      "themeColor": "#0F1712"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "LogiChain utilise votre position pour vous localiser sur le site et déterminer automatiquement votre secteur assigné, y compris lorsque l'application est en arrière-plan.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ]
  }
}
