# {{ ansible_managed }}
# Identifiants utilisés par les scripts de sauvegarde/restauration MongoDB.
# Fichier lisible par root uniquement (mode 0600).
MONGO_HOST={{ mongodb_bind_ip }}
MONGO_PORT={{ mongodb_port }}
MONGO_DB={{ mongodb_database }}
MONGO_USER={{ mongodb_admin_user }}
MONGO_PASSWORD={{ vault_mongodb_admin_password }}
MONGO_AUTH_DB=admin
BACKUP_DIR={{ backup_dir }}
RETENTION_DAYS={{ backup_retention_days }}
