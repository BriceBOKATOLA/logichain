#!/usr/bin/env bash
# {{ ansible_managed }}
#
# Restauration de la base MongoDB LogiChain.
#   Usage : logichain-restore <chemin-de-l-archive> [--force]
#   Sans --force, le script affiche ce qu'il ferait et s'arrête : la
#   restauration ÉCRASE les données courantes, elle ne doit jamais partir
#   d'une faute de frappe.
set -euo pipefail

# shellcheck source=/dev/null
source /etc/logichain/backup.env

ARCHIVE="${1:-}"
FORCE="${2:-}"

if [ -z "$ARCHIVE" ]; then
  echo "Usage : logichain-restore <chemin-de-l-archive> [--force]"
  echo ""
  echo "Sauvegardes disponibles :"
  ls -1sh "${BACKUP_DIR}"/logichain-*.archive.gz 2>/dev/null || echo "  (aucune)"
  exit 1
fi

if [ ! -f "$ARCHIVE" ]; then
  echo "ERREUR : archive introuvable : ${ARCHIVE}" >&2
  exit 1
fi

if ! gzip -t "$ARCHIVE" 2>/dev/null; then
  echo "ERREUR : archive corrompue, restauration refusée : ${ARCHIVE}" >&2
  exit 1
fi

if [ "$FORCE" != "--force" ]; then
  echo "PRÉVISUALISATION — aucune donnée n'a été modifiée."
  echo "  Archive     : ${ARCHIVE}"
  echo "  Base cible  : ${MONGO_DB} (sur ${MONGO_HOST}:${MONGO_PORT})"
  echo ""
  echo "Cette opération REMPLACE le contenu actuel de la base."
  echo "Pour l'exécuter réellement :"
  echo "  logichain-restore ${ARCHIVE} --force"
  exit 0
fi

# Filet de sécurité : on sauvegarde l'état courant AVANT de l'écraser, afin de
# pouvoir revenir en arrière si l'archive restaurée n'était pas la bonne.
echo "[$(date --iso-8601=seconds)] Sauvegarde de sécurité de l'état courant..."
/usr/local/bin/logichain-backup avant-restauration

echo "[$(date --iso-8601=seconds)] Restauration depuis ${ARCHIVE}..."
mongorestore \
  --host "$MONGO_HOST" \
  --port "$MONGO_PORT" \
  --username "$MONGO_USER" \
  --password "$MONGO_PASSWORD" \
  --authenticationDatabase "$MONGO_AUTH_DB" \
  --archive="$ARCHIVE" \
  --gzip \
  --drop \
  --quiet

echo "[$(date --iso-8601=seconds)] Restauration terminée."
echo "Vérifiez l'application : curl -fsS http://127.0.0.1:{{ app_port }}/health"
