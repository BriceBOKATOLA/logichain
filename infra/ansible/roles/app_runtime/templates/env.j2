# {{ ansible_managed }}
# Variables d'environnement de l'API LogiChain — générées par Ansible à partir
# du Vault chiffré. Ce fichier n'existe QUE sur le serveur et n'est jamais
# versionné (cf. .gitignore et docs/SECURITY.md).

NODE_ENV=production
PORT={{ app_port }}

# Connexion à MongoDB : compte applicatif restreint en readWrite sur la seule
# base « {{ mongodb_database }} ». `replicaSet` est requis par les transactions
# ACID, `authSource` désigne la base où le compte a été créé.
MONGO_URI=mongodb://{{ mongodb_app_user }}:{{ vault_mongodb_app_password | urlencode }}@{{ mongodb_bind_ip }}:{{ mongodb_port }}/{{ mongodb_database }}?replicaSet={{ mongodb_replica_set }}&authSource={{ mongodb_database }}

# Secrets JWT. `src/config/env.js` refuse de démarrer si l'un d'eux reste une
# valeur de démonstration ou si les deux sont identiques.
JWT_ACCESS_SECRET={{ vault_jwt_access_secret }}
JWT_REFRESH_SECRET={{ vault_jwt_refresh_secret }}
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Origines autorisées : jamais « * » en production (refusé au démarrage).
CORS_ORIGIN={{ app_cors_origin }}

# Un seul proxy de confiance devant l'API : Nginx. Sans cette valeur, le
# rate-limit d'Express verrait l'IP du proxy pour tous les clients.
TRUST_PROXY=1

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
LOG_LEVEL=info
